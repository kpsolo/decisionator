{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisionator.dev/schemas/plugin-manifest/1.2.json",
  "title": "Deci plugin manifest (decisionator-plugin.json)",
  "$comment": "Changelog:\n- 1.2.0 (2026-10-07, feature 005): Add option extension points: provides.optionProperties, provides.optionView, provides.exposure, platform.optionProperties and platform.optionView (contracts option-properties 1.0.0 and option-view 1.0.0).\n- 1.1.0 (2026-10-05, unreleased pre-implementation): Add projectStore extension point and gis-token OAuth flow (Principle I, FR-025).\n- 1.0.0 (2026-10-05): Initial plugin manifest schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "platform",
    "main",
    "provides"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "description": "Reverse-DNS identifier, unique per plugin.",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){2,}$",
      "examples": [
        "org.decisionator.strategy.random"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "description": "SemVer of the plugin.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "author": {
      "type": "string",
      "maxLength": 120
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier."
    },
    "platform": {
      "type": "object",
      "description": "Contract versions this plugin targets (semver ranges). Host refuses to load on mismatch (Principle II).",
      "additionalProperties": false,
      "required": [
        "runtime"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "examples": [
            "^1.0.0"
          ]
        },
        "strategy": {
          "type": "string"
        },
        "ideaSource": {
          "type": "string"
        },
        "uiSlot": {
          "type": "string"
        },
        "projectStore": {
          "type": "string"
        },
        "optionProperties": {
          "type": "string"
        },
        "optionView": {
          "type": "string"
        }
      }
    },
    "main": {
      "type": "string",
      "description": "Path to the ESM bundle inside the package.",
      "pattern": "^[^/].*\\.m?js$"
    },
    "provides": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "$ref": "#/$defs/strategyDecl"
        },
        "ideaSource": {
          "$ref": "#/$defs/ideaSourceDecl"
        },
        "uiSlots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uiSlotDecl"
          }
        },
        "projectStore": {
          "$ref": "#/$defs/projectStoreDecl"
        },
        "optionProperties": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/optionPropertyDecl"
          },
          "description": "Typed properties this plugin adds to options (contract option-properties 1.0.0). Keys are unique within the plugin."
        },
        "optionView": {
          "$ref": "#/$defs/optionViewDecl"
        },
        "exposure": {
          "type": "boolean",
          "description": "The plugin wants to know when an option has stayed on screen (contract option-view 1.0.0)."
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "const": "clipboard:read"
          },
          {
            "type": "string",
            "pattern": "^net:https://[a-z0-9.-]+(:\\d+)?$",
            "description": "Allowed network origin (CSP connect-src)."
          },
          {
            "type": "string",
            "pattern": "^oauth:[a-z0-9-]+$",
            "description": "Use the host OAuth broker for the provider declared in `oauth`."
          },
          {
            "const": "project:read"
          },
          {
            "const": "ideas:write"
          }
        ]
      },
      "default": []
    },
    "oauth": {
      "type": "object",
      "description": "Provider configs for the host OAuth broker, keyed by provider id used in `oauth:<id>` permissions.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flow",
          "scopes",
          "clientIdEnv"
        ],
        "properties": {
          "flow": {
            "enum": [
              "pkce-loopback",
              "gis-token"
            ],
            "description": "pkce-loopback: authorization code + PKCE via the local node (US5/US6). gis-token: Google Identity Services token model in the browser (MVP)."
          },
          "authorizationEndpoint": {
            "type": "string",
            "format": "uri"
          },
          "tokenEndpoint": {
            "type": "string",
            "format": "uri"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "extraAuthParams": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "returnCallbackParams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Callback query params passed back to the plugin, e.g. picked_file_ids."
          },
          "clientIdEnv": {
            "type": "string",
            "description": "Env var the node reads for the client id."
          },
          "defaultClientId": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "flow": {
                  "const": "pkce-loopback"
                }
              }
            },
            "then": {
              "required": [
                "authorizationEndpoint",
                "tokenEndpoint"
              ]
            }
          }
        ]
      }
    },
    "settingsSchema": {
      "description": "JSON Schema (draft 2020-12) for user settings; the host generates the settings panel from it (FR-053).",
      "type": "object"
    },
    "settingsUiSchema": {
      "type": "object",
      "description": "Optional rjsf uiSchema hints."
    }
  },
  "$defs": {
    "strategyDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usesRandomness",
        "minOptions"
      ],
      "properties": {
        "usesRandomness": {
          "type": "boolean"
        },
        "minOptions": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "requiresWeights": {
          "type": "boolean",
          "default": false
        },
        "ballots": {
          "enum": [
            "none",
            "choice",
            "ranking",
            "score"
          ],
          "default": "none"
        },
        "interactive": {
          "type": "boolean",
          "default": false,
          "description": "Needs a per-run user input form (e.g. manual pick)."
        },
        "runInputSchema": {
          "type": "object",
          "description": "JSON Schema for per-run input when interactive."
        }
      }
    },
    "ideaSourceDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "supportsRefresh"
      ],
      "properties": {
        "sourceType": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "supportsRefresh": {
          "type": "boolean"
        },
        "input": {
          "enum": [
            "clipboard",
            "oauth",
            "form"
          ],
          "description": "How the host collects input before calling the plugin."
        }
      }
    },
    "uiSlotDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "title"
      ],
      "properties": {
        "slot": {
          "enum": [
            "option.detail",
            "project.toolbar",
            "project.sidebar",
            "idea.detail"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 40
        },
        "maxHeight": {
          "type": "integer",
          "minimum": 40,
          "maximum": 800,
          "default": 240
        }
      }
    },
    "projectStoreDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storeKind",
        "supportsPassword",
        "supportsSharing"
      ],
      "properties": {
        "storeKind": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "examples": [
            "google-sheets",
            "local"
          ]
        },
        "supportsPassword": {
          "type": "boolean"
        },
        "supportsSharing": {
          "type": "boolean"
        },
        "supportsIndividualRemoval": {
          "type": "boolean",
          "default": true,
          "description": "False for Google link sharing (research R21)."
        }
      }
    },
    "optionPropertyDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type",
        "scope"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "choice",
            "date"
          ]
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          }
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "scope": {
          "enum": [
            "shared",
            "person"
          ]
        },
        "cardBadge": {
          "type": "boolean",
          "default": false
        },
        "hidden": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "optionViewDecl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "places": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "marker",
              "badges",
              "footer",
              "sections",
              "list"
            ]
          }
        },
        "replaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "marker"
            ]
          }
        }
      }
    }
  },
  "description": "Manifest v1.2 (additive over 1.1): adds the option extension points (optionProperties, optionView, exposure)."
}

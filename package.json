{
  "name": "decisionator-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "test:contract": "vitest run test/contract",
    "test:e2e": "pnpm --filter @decisionator/web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
